PORT=5000
NODE_ENV=development

# Database: local MongoDB for testing, or your MongoDB Atlas connection string for the online version
MONGODB_URI=mongodb://127.0.0.1:27017/safe-workchat
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/safe-workchat?retryWrites=true&w=majority

# Secrets: use long random strings (for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me

# Sign in with Google (leave empty to hide the Google button)
# Create a "Web application" OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Optional
# DISPLAY_TZ=Asia/Kolkata
# DUE_SOON_HOURS=24


# Email notifications (Gmail SMTP). Use a Google App Password, never your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
INACTIVE_EMAIL_DAYS=7
