PORT=5000
NODE_ENV=development

# Database: local MongoDB for testing, or your MongoDB Atlas connection string for the online version
MONGODB_URI=mongodb://127.0.0.1:27017/safe-workchat
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/safe-workchat?retryWrites=true&w=majority

# Secrets: use long random strings (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me
# Protects the encryption keys of accounts created with Google sign-in (AES-256-GCM). 32+ characters.
# Set it once and never change it (changing it makes those keys unreadable). Falls back to JWT_SECRET if empty.
KEY_WRAP_SECRET=

# Public address of the app (used in e-mail links, e.g. password reset). No trailing slash.
APP_URL=http://localhost:5000

# Sign in with Google (leave empty to hide the Google button)
GOOGLE_CLIENT_ID=

# ---- E-mail (recommended: Resend HTTPS API; SMTP is optional fallback) ----
EMAIL_NOTIFICATIONS=true
# Resend: create an API key at https://resend.com/api-keys and verify a sending domain.
RESEND_API_KEY=
MAIL_FROM="Safe WorkChat <notifications@your-verified-domain.com>"
# Optional SMTP fallback (used only when RESEND_API_KEY is empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ---- Notification schedule ----
DUE_SOON_HOURS=24                 # "deadline approaching" window
OVERDUE_EMAIL_DAYS=7              # stop e-mailing about a task that has been overdue longer than this
INACTIVITY_DAYS=7                 # e-mail users who have not been active for this many days
INACTIVITY_CHECK_CRON=0 * * * *   # how often to look for inactive users (default hourly)
EMAIL_TASK_CRON=* * * * *         # how often to look for due / overdue tasks (default every minute)
EMAIL_MAX_ATTEMPTS=3              # retries for a failed e-mail
EMAIL_MAX_PER_RUN=50
PASSWORD_RESET_MINUTES=60

# ---- Uploads ----
MAX_UPLOAD_MB=10
# Folder for uploaded files. On Render, point this at a persistent disk (e.g. /var/data/uploads).
# UPLOAD_DIR=

# Optional
# DISPLAY_TZ=Asia/Kolkata
